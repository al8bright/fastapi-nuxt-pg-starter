# 백엔드 환경변수 — 실제 값은 .env 에 채우고 커밋하지 않는다 (architecture.md §5, §17)

# DB (psql 로 생성한 데이터베이스)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/__PROJECT_SNAKE__

# JWT / 세션
# SECRET_KEY 는 32자 이상 랜덤 필수 (스캐폴드가 자동 생성). 기본값/짧은 키로는 기동이 거부된다.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# 쿠키 — 운영 HTTPS 환경에서는 true (refresh 쿠키 Secure 속성 + HSTS 헤더)
COOKIE_SECURE=false

# 초기 관리자 시드 — INITIAL_ADMIN_PASSWORD 미설정 시 관리자 시드를 건너뛴다 (기동 로그에 경고)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# CORS (콤마 구분)
CORS_ORIGINS=http://localhost:5173

# URL
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000

# 실행 시각대 (KST 고정)
TZ=Asia/Seoul
